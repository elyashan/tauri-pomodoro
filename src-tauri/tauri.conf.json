{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pomodoro-widget",
  "version": "0.1.4",
  "identifier": "com.pomodoro.widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Pomodoro",
        "width": 240,
        "height": 124,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwNEEyRjc3NjZFNTFGOTYKUldTV0grVm1keTlLSU9WVEFhQmcxdFdlb0phNTBKY0JaZXYwZTNjRlp5dTY3M2FXUlBHY3NXdlQK",
      "endpoints": [
        "https://github.com/elyashan/tauri-pomodoro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
